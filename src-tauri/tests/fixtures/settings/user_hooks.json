{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Read"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/log.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File C:/Users/someone/notify.ps1"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo hello"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true
}
